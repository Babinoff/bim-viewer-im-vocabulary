ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Van Gogh Inspired BIM Model'), '2;1');
FILE_NAME('van_gogh_house.ifc', '2025-05-05T12:00:00', ('DeepSeek'), ('DeepSeek BIM Team'), 'v1.0', 'IFC4');
FILE_SCHEMA(('IFC4'));
ENDSEC;

DATA;
#1 = IFCBUILDING('3q4mR5X1z0yB9wV2', $, 'Van Gogh House', $, $, $, $, $, .ELEMENT., $, $);
#2 = IFCSITE('2s9kL8P4n7tR6wX1', $, 'Artistic Land', $, $, $, $, $, .ELEMENT., $, $, $, $, $);
#3 = IFCBUILDINGSTOREY('1r5tY9u2i3oP7wQ8', $, 'First Floor', $, $, #1, $, .ELEMENT., $, $);

/* Стена с текстурой в стиле Ван Гога */
#4 = IFCWALL('5tG7hJ3kL9pO2wE4', $, 'Van Gogh Wall', $, $, #3, $, $, $);
#5 = IFCMATERIAL('6yU8iK4lP0oQ3wR5', 'Yellow Ochre Paint', $, $);
#6 = IFCMATERIALLAYERSET($, (#5), 'Paint Layer');
#7 = IFCMATERIALLAYERSETUSAGE(#6, .AXIS2., .POSITIVE., 0.1);
#8 = IFCSHAPEREPRESENTATION($, 'Body', 'SweptSolid', (#9));
#9 = IFCEXTRUDEDAREASOLID(#10, $, #11, 3.0);
#10 = IFCRECTANGLEPROFILEDEF(.AREA., 'Wall Profile', $, 0.2, 2.8);
#11 = IFCAXIS2PLACEMENT3D(#12, $, $);
#12 = IFCCARTESIANPOINT((0., 0., 0.));

/* Окно с витражным эффектом */
#13 = IFCWINDOW('7uH5jK9lP2oQ4wR6', $, 'Starry Window', $, $, #3, $, $, $);
#14 = IFCSHAPEREPRESENTATION($, 'Body', 'SweptSolid', (#15));
#15 = IFCEXTRUDEDAREASOLID(#16, $, #17, 0.1);
#16 = IFCRECTANGLEPROFILEDEF(.AREA., 'Window Profile', $, 1.2, 1.5);
#17 = IFCAXIS2PLACEMENT3D(#18, $, $);
#18 = IFCCARTESIANPOINT((2.0, 0.5, 1.2));

/* Крыша с волнообразной формой */
#19 = IFCROOF('8iK3lP9oQ2wR5tY7', $, 'Swirling Roof', $, $, #3, $, $, $);
#20 = IFCSHAPEREPRESENTATION($, 'Body', 'SweptSolid', (#21));
#21 = IFCEXTRUDEDAREASOLID(#22, $, #23, 0.5);
#22 = IFCCIRCLEPROFILEDEF(.AREA., 'Roof Profile', $, 4.0);
#23 = IFCAXIS2PLACEMENT3D(#24, $, $);
#24 = IFCCARTESIANPOINT((0., 0., 3.0));

ENDSEC;
END-ISO-10303-21;